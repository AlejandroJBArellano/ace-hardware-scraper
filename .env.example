# Ace Hardware Store Scraper — Environment Configuration
# Copy this file to .env and adjust the values.

# ── ID Range ──────────────────────────────────────────────────────────────────
# Store IDs are NOT auto-incremental; this range covers all known patterns.
ID_START=10000
ID_END=25000

# ── Performance ───────────────────────────────────────────────────────────────
# Number of concurrent HTTP requests. Keep ≤ 10 to avoid rate-limiting.
CONCURRENCY=5

# Delay (ms) added between requests per slot (anti-bot pacing).
REQUEST_DELAY=1000

# Delay (ms) added between retries and used as base for exponential back-off.
BATCH_DELAY=500

# HTTP request timeout in milliseconds.
REQUEST_TIMEOUT=15000

# Retry attempts per store ID before marking it as not found.
RETRIES=3

# ── ZenRows (optional — bypasses Cloudflare via residential proxies) ───────────
# Sign up free at https://www.zenrows.com/ — free tier = 1,000 API credits.
# With premium_proxy=true each request costs 10 credits (100 test requests free).
# When set, ALL requests are routed through ZenRows instead of direct HTTP.
ZENROWS_API_KEY=

# ── Output ────────────────────────────────────────────────────────────────────
# Absolute or relative path for the generated Excel file.
# OUTPUT_PATH=./output/stores.xlsx
